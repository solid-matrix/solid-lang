// Shifts.
func _shift_left<TLeft, TRight, F: ShiftLeftOp<TLeft, TRight>>(left: TLeft, right: TRight): F::TResult {
  return F(left, right);
}

func _shift_right<TLeft, TRight, F: ShiftRightOp<TLeft, TRight>>(left: TLeft, right: TRight): F::TResult {
  return F(left, right);
}

// Bitwise.
func _bit_not<T, F: BitNotOp<T>>(item: T): F::TResult {
  return F(item);
}

func _bit_and<TLeft, TRight, F: BitAndOp<TLeft, TRight>>(left: TLeft, right: TRight): F::TResult {
  return F(left, right);
}

func _bit_xor<TLeft, TRight, F: BitXorOp<TLeft, TRight>>(left: TLeft, right: TRight): F::TResult {
  return F(left, right);
}

func _bit_or<TLeft, TRight, F: BitOrOp<TLeft, TRight>>(left: TLeft, right: TRight): F::TResult {
  return F(left, right);
}

@intrinsic func as_readonly<T>(item: &T): &readonly T;

@intrinsic func as_writeonly<T>(item: &T): &writeonly T;

// EqualOp reference family: 4x4 full matrix, all lower to pointer equality.

@intrinsic func _equal_ref_rw_rw<T>(left: &T, right: &T): bool fulfills EqualOp<&T, &T>;
@intrinsic func _equal_ref_rw_ro<T>(left: &T, right: &readonly T): bool fulfills EqualOp<&T, &readonly T>;
@intrinsic func _equal_ref_rw_wo<T>(left: &T, right: &writeonly T): bool fulfills EqualOp<&T, &writeonly T>;
@intrinsic func _equal_ref_rw_na<T>(left: &T, right: &noaccess T): bool fulfills EqualOp<&T, &noaccess T>;

@intrinsic func _equal_ref_ro_rw<T>(left: &readonly T, right: &T): bool fulfills EqualOp<&readonly T, &T>;
@intrinsic func _equal_ref_ro_ro<T>(left: &readonly T, right: &readonly T): bool fulfills EqualOp<&readonly T, &readonly T>;
@intrinsic func _equal_ref_ro_wo<T>(left: &readonly T, right: &writeonly T): bool fulfills EqualOp<&readonly T, &writeonly T>;
@intrinsic func _equal_ref_ro_na<T>(left: &readonly T, right: &noaccess T): bool fulfills EqualOp<&readonly T, &noaccess T>;

@intrinsic func _equal_ref_wo_rw<T>(left: &writeonly T, right: &T): bool fulfills EqualOp<&writeonly T, &T>;
@intrinsic func _equal_ref_wo_ro<T>(left: &writeonly T, right: &readonly T): bool fulfills EqualOp<&writeonly T, &readonly T>;
@intrinsic func _equal_ref_wo_wo<T>(left: &writeonly T, right: &writeonly T): bool fulfills EqualOp<&writeonly T, &writeonly T>;
@intrinsic func _equal_ref_wo_na<T>(left: &writeonly T, right: &noaccess T): bool fulfills EqualOp<&writeonly T, &noaccess T>;

@intrinsic func _equal_ref_na_rw<T>(left: &noaccess T, right: &T): bool fulfills EqualOp<&noaccess T, &T>;
@intrinsic func _equal_ref_na_ro<T>(left: &noaccess T, right: &readonly T): bool fulfills EqualOp<&noaccess T, &readonly T>;
@intrinsic func _equal_ref_na_wo<T>(left: &noaccess T, right: &writeonly T): bool fulfills EqualOp<&noaccess T, &writeonly T>;
@intrinsic func _equal_ref_na_na<T>(left: &noaccess T, right: &noaccess T): bool fulfills EqualOp<&noaccess T, &noaccess T>;
